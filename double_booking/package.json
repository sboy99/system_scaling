{
  "name": "double_booking",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:setup": "psql -f db/schema.sql",
    "bench:real": "npx tsx scripts/benchmark.ts --scenario mixed --rooms 10 --slots 10 --requests 2000 --concurrency 200",
    "bench:raw": "npx tsx scripts/benchmark.ts --scenario distinct --requests 5000 --concurrency 200",
    "bench:verify": "npx tsx scripts/benchmark.ts --scenario contention --requests 1000 --concurrency 1000 --verify"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
